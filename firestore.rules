rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'REPLACE_WITH_ADMIN_GMAIL'; }
    match /shared/{kind} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && kind == 'expenses');
    }
    match /checks/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
